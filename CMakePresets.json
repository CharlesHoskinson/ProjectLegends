{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "LEGENDS_HEADLESS": "ON"
      }
    },
    {
      "name": "default-ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "LEGENDS_HEADLESS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Dev (Debug + Tests)",
      "description": "Debug build with all tests enabled",
      "inherits": "default-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LEGENDS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev-mingw",
      "displayName": "Dev (Debug + Tests, MinGW Makefiles)",
      "description": "Debug build with all tests enabled using MinGW Makefiles",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LEGENDS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build",
      "inherits": "default-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan",
      "description": "AddressSanitizer and UndefinedBehaviorSanitizer build",
      "inherits": "default-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined",
        "LEGENDS_BUILD_TESTS": "ON"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan",
      "description": "ThreadSanitizer build",
      "inherits": "default-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -fsanitize=thread",
        "LEGENDS_BUILD_TESTS": "ON"
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "ipc",
      "displayName": "IPC Mode",
      "description": "GPL v2 process isolation build (engine host + proxy)",
      "inherits": "default-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LEGENDS_BUILD_TESTS": "ON",
        "LEGENDS_USE_IPC": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "description": "Debug build with gcov coverage instrumentation",
      "inherits": "default-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc-13",
        "CMAKE_CXX_COMPILER": "g++-13",
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
        "CMAKE_C_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "LEGENDS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzz (Clang + libFuzzer)",
      "description": "Fuzzing build with libFuzzer and ASan",
      "inherits": "default-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18",
        "ENABLE_FUZZING": "ON",
        "ENABLE_ASAN": "ON",
        "LEGENDS_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-mingw",
      "configurePreset": "dev-mingw"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "ipc",
      "configurePreset": "ipc"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-mingw",
      "configurePreset": "dev-mingw",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "ipc",
      "configurePreset": "ipc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
